# Cloudflare Pages Headers — SocialHub Automated Cache-Control Rules

# HTML pages — always check for fresh version (no browser cache)
/*.html
  Cache-Control: no-cache, must-revalidate

# Central Configuration Script — never cache stale config
/js/config.js
  Cache-Control: no-cache, must-revalidate

# Unhashed JS & CSS modules — revalidate on every visit for instant updates
/js/*
  Cache-Control: no-cache, must-revalidate

/css/*
  Cache-Control: no-cache, must-revalidate

# Static Images & Media — cache 30 days (2,592,000 seconds) for speed
/*.png
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.jpeg
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.ico
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

# Vite-built assets with content hashes in filename
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker — never cache (must always be fresh)
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
